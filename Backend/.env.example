# ==============================================================================
# SMALLTHINGS BACKEND ENVIRONMENT TEMPLATE
# Copy this file to .env and replace placeholders with your actual credentials.
# ==============================================================================

# MongoDB Atlas Connection String
# 1. Log in to MongoDB Atlas (https://cloud.mongodb.com)
# 2. Go to Database > Connect > Drivers > Node.js
# 3. Copy the connection string and replace <password> with your database user password
# 4. Replace <database-name> with your preferred database name (e.g. smallthings)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/smallthings?retryWrites=true&w=majority

# Server Port (Default: 5000)
PORT=5000

# JWT Authentication Secret Key (Generate a random 32+ character string for production)
JWT_SECRET=your_jwt_secret_key_here

# Stripe Payment Gateway Secret Key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

